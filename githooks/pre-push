#!/bin/bash

echo "Ejecutando tests con PHPUnit antes del push..."

PHPUNIT="./vendor/bin/phpunit"

if [ ! -f "$PHPUNIT" ]; then
  echo "PHPUnit no encontrado en $PHPUNIT"
  exit 1
fi

php "$PHPUNIT" --colors=always
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo "Los tests han fallado. Push cancelado."
  exit 1
fi

echo "Todos los tests pasaron. Puedes hacer push."
exit 0
