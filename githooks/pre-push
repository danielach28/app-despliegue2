#!/usr/bin/env php
<?php

echo "Ejecutando tests con PHPUnit antes del push...\n";

$output = [];
$returnCode = 0;
exec('php vendor/phpunit/phpunit/phpunit --colors=always', $output, $returnCode);

foreach ($output as $line) {
    echo $line . "\n";
}

if ($returnCode !== 0) {
    echo "Los tests han fallado. Push cancelado.\n";
    exit(1);
}

echo "Todos los tests pasaron. Puedes hacer push.\n";
exit(0);

